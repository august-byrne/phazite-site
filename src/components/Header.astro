---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Starlight's header; and, on a page without a sidebar (the home page, the missing page), the menu button and menu that
// every other page has on a narrow screen. Starlight gives its menu only to pages with a sidebar, so on a phone the home
// page would have had no way to the site's sections or its theme switch. The menu is Starlight's own sidebar, opened as
// Starlight opens it (a popover, which needs no script), with its button's look (MobileMenuToggle.astro, MIT).
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Header.astro';
import Sidebar from 'virtual:starlight/components/Sidebar';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<Default />
{
	!hasSidebar && (
		<div class="site-menu md:sl-hidden print:hidden">
			<button popovertarget="pz-site-menu" class="menu-button sl-flex">
				<Icon name="bars" class="open-menu" />
				<Icon name="close" class="close-menu" />
				<span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
			</button>
			<nav id="pz-site-menu" popover="auto" class="menu-pane" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				<div class="sidebar-content sl-flex">
					<Sidebar />
				</div>
			</nav>
		</div>
	)
}

<script>
	// As Starlight's menu does: while it is open, what is under it can't take the keyboard's focus; and it closes when the
	// window grows wide enough to show the header's own links.
	const menu = document.getElementById('pz-site-menu');
	if (menu) {
		menu.addEventListener('toggle', (event) => {
			const open = (event as ToggleEvent).newState === 'open';
			document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((element) => {
				element.toggleAttribute('inert', open);
			});
		});
		matchMedia('(min-width: 50em)').addEventListener('change', (query) => {
			if (query.matches && menu.matches(':popover-open')) menu.hidePopover();
		});
	}
</script>

<style>
	.menu-button {
		position: fixed;
		top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
		inset-inline-end: var(--sl-nav-pad-x);
		z-index: var(--sl-z-index-navbar);
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: 50%;
		width: var(--sl-menu-button-size);
		height: var(--sl-menu-button-size);
		padding: 0.5rem;
		background-color: var(--sl-color-white);
		color: var(--sl-color-black);
		box-shadow: var(--sl-shadow-md);
		cursor: pointer;
	}

	.menu-button:has(~ :popover-open) {
		background-color: var(--sl-color-gray-2);
		box-shadow: none;
	}

	.menu-button:has(~ :popover-open) .open-menu,
	.menu-button:not(:has(~ :popover-open)) .close-menu {
		display: none;
	}

	:global([data-theme='light']) .menu-button {
		background-color: var(--sl-color-black);
		color: var(--sl-color-white);
	}

	:global([data-theme='light']) .menu-button:has(~ :popover-open) {
		background-color: var(--sl-color-gray-5);
	}

	.menu-pane {
		position: fixed;
		z-index: var(--sl-z-index-menu);
		inset-block: var(--sl-nav-height) 0;
		inset-inline: 0;
		width: 100%;
		height: auto;
		margin: 0;
		border: 0;
		padding: 0;
		color: inherit;
		background-color: var(--sl-color-black);
		overflow-y: auto;
		scrollbar-gutter: stable;
	}

	.sidebar-content {
		height: 100%;
		min-height: max-content;
		padding: 1rem var(--sl-sidebar-pad-x) 0;
		flex-direction: column;
		gap: 1rem;
	}
</style>
